{
  "manifest_version": 3,
  "name": "X Feed Image Downloader",
  "version": "1.1.0",
  "description": "Downloads images found in X/Twitter feed posts from a specified profile.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "X Feed Image Downloader"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  }
}