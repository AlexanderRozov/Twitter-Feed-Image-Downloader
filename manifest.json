{
  "manifest_version": 3,
  "name": "Image Feed Downloader",
  "version": "1.3.0",
  "description": "Original-size image downloader for X/Twitter and Booru galleries with background-compatible scanning, tag filters and queue management.",
  "minimum_chrome_version": "120",
  "permissions": [
    "debugger",
    "tabs",
    "scripting",
    "downloads",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://danbooru.donmai.us/*",
    "https://gelbooru.com/*",
    "https://rule34.xxx/*",
    "https://api.rule34.xxx/*",
    "https://*.rule34.xxx/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Image Feed Downloader"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "options_page": "queue/queue.html"
}
